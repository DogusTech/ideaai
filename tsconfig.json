{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/dev/types/**/*.ts",
    "app/ai-landing-page.tsx",
    "app/ai-landing-page/firebaseConfig.ts",
    "app/ai-landing-page/firebaseConfig.tsx",
    "app/ai-login/**/*",
    "app/api/[id].ts",
    "app/api/main.ts",
    "app/app/firebaseConfig.ts",
    "app/components/**/*",
    "app/pages/**/*",
    "app/user/**/*",
    "components/Header.tsx",
    "components/MenuItemLink*.tsx",
    "components/ui/AiLandingPage.tsx",
    "components/ui/Button.tsx",
    "components/ui/container.tsx",
    "components/ui/Input.tsx",
    "components/ui/Layout.tsx",
    "components/ui/Login.tsx",
    "components/ui/Typography.tsx",
    "ui-main",
    ".next/types/**/*.ts",
    "app/api/ai.tsx",
    "app/api/ai.test.tsx",
    "app/api/createDocument.ts",
    "app/api/createDocument.tsx",
    "pages/_app.tsx"
  ]
}
