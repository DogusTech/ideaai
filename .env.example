# -----------------------------------------------------------------------------
# IdeaAI Open-Source Environment Configuration
# -----------------------------------------------------------------------------
# Copy this file to .env.local or .env and fill in the values you want to use.
# IdeaAI works 100% offline with Local Ollama out of the box without any keys!

# =============================================================================
# 1. CORE ENGINE & LLM PROVIDER SETTINGS (Local or Cloud)
# =============================================================================
# Provider: 'ollama' (default, free & 100% offline) or 'openai'
IDEAAI_PROVIDER=ollama
IDEAAI_MODEL=llama3.2

# Ollama local endpoint (default is http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# (Optional) If using OpenAI or OpenAI-compatible endpoint (Groq, Together, DeepSeek, vLLM)
OPENAI_API_KEY=your_openai_or_groq_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# =============================================================================
# 2. LOCAL WORKSPACE & DESKTOP APP
# =============================================================================
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# 3. (OPTIONAL) COMMUNITY CI/CD & GITHUB REPO INTEGRATION
# =============================================================================
# Enables autonomous overnight git PR reviews & auto commits
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# =============================================================================
# 4. (OPTIONAL) CLOUD BACKEND & AUTH (Firebase Community / Self-hosted)
# =============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
